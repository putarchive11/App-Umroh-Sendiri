# Salin nilai-nilai ini ke Vercel → Project (App-Umroh-Sendiri) → Settings → Environment Variables.
# JANGAN menaruh kunci asli di file ini atau di GitHub (repo ini publik).

# ── Sudah ada (kode aktivasi) ──
ADMIN_PASSWORD=
# KV_REST_API_URL dan KV_REST_API_TOKEN terisi otomatis dari Storage → Upstash.

# ── Midtrans (wajib untuk checkout otomatis) ──
# Sandbox berawalan "SB-Mid-server-", produksi berawalan "Mid-server-".
MIDTRANS_SERVER_KEY=
# Hanya untuk masa uji sandbox: kata sandi buatan sendiri. Buka landing dengan ?uji=<nilai ini>.
KUNCI_UJI=

# ── Meta Conversions API (opsional, untuk iklan) ──
META_PIXEL_ID=
META_CAPI_TOKEN=
# Isi sementara saat menguji di Events Manager → Test Events, lalu HAPUS.
META_TEST_EVENT_CODE=

# ── Email kode aktivasi lewat Resend (opsional tapi sangat disarankan) ──
RESEND_API_KEY=
EMAIL_PENGIRIM=Kunci Umroh Mandiri <halo@umrohsendiri.biz.id>
EMAIL_BALASAN=umrohsendri@gmail.com
# Tembusan tiap penjualan ke admin (opsional).
EMAIL_ADMIN=

# ── Opsional, bawaan sudah benar ──
# HARGA_PAKET=125000
# URL_APLIKASI=https://app-umroh-sendiri.vercel.app
# URL_LANDING=https://www.umrohsendiri.biz.id
# ASAL_DIIZINKAN=https://alamat-preview-landing.vercel.app
# MIDTRANS_METODE=other_qris,gopay,shopeepay,bank_transfer
